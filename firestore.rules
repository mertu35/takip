rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcının rolünü çeken yardımcı fonksiyon
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'sales';
    }

    // Giriş yapılıp yapılmadığını kontrol eden yardımcı fonksiyon
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminOrSysadmin() {
      return getUserRole() == 'admin' || getUserRole() == 'sysadmin';
    }

    // --- USERS KOLEKSİYONU ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdminOrSysadmin());
      allow update: if isSignedIn() && (
        isAdminOrSysadmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled']))
      );
      allow delete: if isSignedIn() && isAdminOrSysadmin();
    }

    // --- CUSTOMERS KOLEKSİYONU ---
    match /customers/{customerId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && isAdminOrSysadmin();
    }

    // --- PRODUCTS KOLEKSİYONU ---
    // İş kuralı: ürün kartını (ekleme, fiyat, isim, kod) SATIŞÇI yönetir.
    // Muhasebe stoğu, satışları ve fiyatları GÖRÜR ama ürüne dokunamaz.
    //
    // Tek istisna 'stock' alanı: muhasebeci onay/red ve "Miktarları Düzenle"
    // işlemlerinde stoğu değiştirmek zorunda. Bu yüzden stok yazması role
    // değil ALANA bağlı olarak herkese açık; diğer tüm alanlar satışçı ve
    // yöneticiyle sınırlı.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (getUserRole() == 'sales' || isAdminOrSysadmin());
      allow update: if isSignedIn() && (
        getUserRole() == 'sales' ||
        isAdminOrSysadmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
      );
      allow delete: if isSignedIn() && isAdminOrSysadmin();
    }

    // --- CATEGORIES KOLEKSİYONU ---
    // Kategoriler ürün kartının parçası olduğu için ürünle aynı yetkide:
    // satışçı yönetir, muhasebe yalnızca görür.
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (getUserRole() == 'sales' || isAdminOrSysadmin());
      allow delete: if isSignedIn() && isAdminOrSysadmin();
    }

    // --- SALES KOLEKSİYONU ---
    match /sales/{saleId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdminOrSysadmin() ||
        getUserRole() == 'accounting' ||
        (
          resource.data.salespersonId == request.auth.uid &&
          resource.data.status == 'pending_accounting' &&
          request.resource.data.status == 'pending_accounting' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'accountingProcessed', 'processedAt', 'processedBy', 'receiptNo'])
        )
      );
      allow delete: if isSignedIn() && isAdminOrSysadmin();
    }

    // --- PAYMENTS KOLEKSİYONU (Tahsilatlar) ---
    match /payments/{paymentId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isAdminOrSysadmin() || getUserRole() == 'accounting');
    }

    // --- PROPOSALS KOLEKSİYONU (Teklif Mektupları) ---
    // Güvenlik & Manipülasyon Önlemi: Satışçılar teklif oluşturabilir fakat sonradan düzenleyemez/silemez.
    match /proposals/{proposalId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && isAdminOrSysadmin();
    }

    // --- APPROVALS KOLEKSİYONU ---
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdminOrSysadmin() || getUserRole() == 'accounting');
      allow update, delete: if false;
    }

    // --- LOGS KOLEKSİYONU (Değiştirilemez Denetim İzi) ---
    match /logs/{logId} {
      allow read: if isSignedIn() && isAdminOrSysadmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- ANNOUNCEMENTS KOLEKSİYONU ---
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (getUserRole() == 'sysadmin' || getUserRole() == 'admin');
    }

    // --- NOTIFICATIONS KOLEKSİYONU ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // --- SETTINGS KOLEKSİYONU ---
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isAdminOrSysadmin();
    }

    // --- COUNTERS KOLEKSİYONU ---
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }
  }
}
